OCI_GENAI_MODEL=cohere.command-r-plus
OCI_GENAI_API_KEY=replace-me
OCI_GENAI_PROJECT_OCID=
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MCP_GATEWAY_TOKEN=
