# Complemento opcional ao .env do agente. Ajuste para o endereço público real.
ENABLE_A2A=true
A2A_TASK_MODE=true
A2A_PUBLIC_URL=http://localhost:8000
A2A_TASK_TIMEOUT_SECONDS=240
# AGENT_AUTH_* configura o middleware já fornecido pelo framework.
# Exemplo de declaração no Agent Card (não habilita autenticação):
# A2A_SECURITY_SCHEMES={"gatewayBearer":{"httpAuthSecurityScheme":{"scheme":"bearer"}}}
# A2A_SECURITY=[{"gatewayBearer":[]}]
